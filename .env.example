# RyzeHub - environment configuration
# Copy to .env and fill in.

# ─── RyzeAuth control plane ───────────────────────────────────
# Keycloak realm fronted by ryzespace/RyzeAuth.
RYZEAUTH_AUTHORITY=http://localhost:8080/realms/ryzespace
RYZEAUTH_AUDIENCE=ryzehub-api
# RyzeAuth ASP.NET Core API (REST + gRPC).
RYZEAUTH_API_BASE_URL=http://localhost:8081
RYZEAUTH_CLIENT_ID=ryzehub-service
RYZEAUTH_CLIENT_SECRET=
# Scope an API key must carry before RyzeHub accepts a pipeline request.
RYZEAUTH_REQUIRED_SCOPE=hub:tickets:transfer
RYZEAUTH_API_KEY_INTROSPECTION=true
RYZEAUTH_FORWARD_AUDIT=true

# ─── Source: Client Dashboard ─────────────────────────────────
CLIENT_DASHBOARD_URL=https://client-dashboard.example.com/api/v1
CLIENT_DASHBOARD_API_KEY=your-api-key-here
SOURCE_TIMEOUT=30
SOURCE_MAX_RETRIES=3
SOURCE_BATCH_SIZE=50
SOURCE_RATE_LIMIT=100

# ─── Destination: HelpCenter ──────────────────────────────────
HELPCENTER_URL=https://helpcenter.example.com/api/v1
HELPCENTER_API_KEY=your-api-key-here
DEST_TIMEOUT=30
DEST_MAX_RETRIES=3
DEST_RATE_LIMIT=100

# ─── Security ─────────────────────────────────────────────────
# 256-bit keys in base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
SIGNING_KEY=
AUDIT_LOG_ENABLED=true
CHECKSUM_ENABLED=true
VAULT_PATH=vault.json
VAULT_USER=system

# ─── Pipeline ─────────────────────────────────────────────────
PIPELINE_LOG_LEVEL=Information
POLL_INTERVAL=300

# ─── Hub platform ─────────────────────────────────────────────
HUB_EVENT_RETENTION_SECONDS=86400
HUB_CACHE_PROVIDER=redis
HUB_CACHE_TTL_SECONDS=3600
HUB_GATEWAY_BASE_PATH=/api
HUB_GATEWAY_RATE_LIMIT=120
HUB_TELEMETRY_ENABLED=true
HUB_NOTIFICATION_RETENTION_SECONDS=604800

# ─── Hub manager (GitHub) ─────────────────────────────────────
HUB_ORG_NAME=ryzespace
GITHUB_TOKEN=
HUB_DIR=github_hub
