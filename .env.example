# Ticket Pipeline - Environment Variables
# Skopiuj do .env i wypełnij / Copy to .env and fill in

# ─── Source: Client Dashboard ─────────────────────────────────
CLIENT_DASHBOARD_URL=https://client-dashboard.example.com/api/v1
CLIENT_DASHBOARD_API_KEY=your-api-key-here
SOURCE_TIMEOUT=30
SOURCE_MAX_RETRIES=3
SOURCE_BATCH_SIZE=50
SOURCE_RATE_LIMIT=100

# ─── Destination: HelpCenter ──────────────────────────────────
HELPCENTER_URL=https://helpcenter.example.com/api/v1
HELPCENTER_API_KEY=your-api-key-here
DEST_TIMEOUT=30
DEST_MAX_RETRIES=3
DEST_RATE_LIMIT=100

# ─── Security ─────────────────────────────────────────────────
# 256-bit key in base64 / Klucz 256-bit w base64
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true
CHECKSUM_ENABLED=true

# ─── Pipeline ─────────────────────────────────────────────────
PIPELINE_LOG_LEVEL=info
POLL_INTERVAL=300
